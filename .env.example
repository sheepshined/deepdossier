# ============ LLM Provider（OpenAI 兼容协议，base_url 可换任意厂商） ============
# DeepSeek:    https://api.deepseek.com/v1        model: deepseek-chat
# 智谱 GLM:    https://open.bigmodel.cn/api/paas/v4  model: glm-4-plus
# OpenRouter:  https://openrouter.ai/api/v1       model: openai/gpt-4o
# Ollama 本地: http://localhost:11434/v1          model: llama3.1
DOSSIER_LLM_PROVIDER=openai_compatible
DOSSIER_LLM_BASE_URL=https://api.deepseek.com/v1
DOSSIER_LLM_API_KEY=sk-xxx
DOSSIER_LLM_MODEL=deepseek-chat
# 快模型（Planner 摘要/Critic 等轻任务），留空则与主模型一致
DOSSIER_LLM_FAST_MODEL=
DOSSIER_TEMPERATURE=0.3
# 单次研究的 LLM 调用硬预算（防成本失控）
DOSSIER_LLM_MAX_RETRIES=2
DOSSIER_MAX_LLM_CALLS=150
# 单次 LLM 调用超时与慢调用事件阈值（R28）
DOSSIER_LLM_TIMEOUT_SECONDS=120
DOSSIER_SLOW_CALL_SECONDS=60
# 三重成本熔断（R27）：次数(MAX_LLM_CALLS)/token/金额，任一触发即停；价格表用于金额估算
DOSSIER_MAX_RUN_TOKENS=600000
DOSSIER_MAX_RUN_COST_CNY=10
DOSSIER_PRICE_INPUT_CNY_PER_M=2
DOSSIER_PRICE_OUTPUT_CNY_PER_M=8
# embedding 模型（用于策略记忆的语义检索）；留空退化为字符 n-gram 匹配
DOSSIER_EMBEDDING_MODEL=

# ============ 搜索 Retriever：so360（国内网络推荐，免key） | duckduckgo（默认，免key） | bing | tavily | serper | stub ============
DOSSIER_RETRIEVER=duckduckgo
# 主检索器异常/零结果时依次降级（逗号分隔，如：bing,duckduckgo）
DOSSIER_RETRIEVER_FALLBACKS=
DOSSIER_SEARCH_TOP_K=5
DOSSIER_TAVILY_API_KEY=
DOSSIER_SERPER_API_KEY=

# ============ 研究行为 ============
# 问题路由：开头判断是否真需要调研（闲聊/简单询问直接回答）
DOSSIER_QUESTION_ROUTING=true
DOSSIER_MAX_SUBQUESTIONS=5
DOSSIER_MAX_RESEARCH_ROUNDS=2
DOSSIER_MAX_SOURCES_PER_QUESTION=3
# 来源质量过滤：检索结果先经轻量模型相关性筛选（true 开启，约每子问题 +1 次轻量调用）
DOSSIER_SOURCE_CURATION=true
# 草稿级事实审查：报告草稿经 Verifier 审查、按需单轮修订
DOSSIER_DRAFT_REVIEW=true
DOSSIER_REPORT_LANGUAGE=zh
# 离线演示/省流量：true 只用搜索摘要、不抓网页正文
DOSSIER_FETCH_PAGES=true

# ============ 服务 ============
DOSSIER_HOST=127.0.0.1
DOSSIER_PORT=8000
# 设置后所有 /api/* 端点（含 SSE events）需要 X-API-Key 请求头
DOSSIER_API_KEY=
# 逗号分隔的允许跨域来源；留空不启用 CORS
DOSSIER_CORS_ORIGINS=
# 每分钟创建任务数上限（按 API key / 客户端 IP），0 = 关闭
DOSSIER_RATE_LIMIT_PER_MINUTE=10
# 后台研究并发上限与单 run 硬超时（秒）
DOSSIER_MAX_CONCURRENT_RUNS=4
DOSSIER_RUN_TIMEOUT_SECONDS=600
# true 时 POST 请求内联执行（测试/调试用），生产保持 false
DOSSIER_INLINE_EXECUTION=false
DOSSIER_CHECKPOINTING=true
DOSSIER_MCP_SERVERS=
DOSSIER_DATA_DIR=./data

# ============ 存储保留策略（每次服务启动时执行） ============
DOSSIER_RETENTION_DAYS=30
DOSSIER_MAX_LESSONS=500
